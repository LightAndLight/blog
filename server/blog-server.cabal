cabal-version:      3.0
name:               blog-server
version:            0.1.0.0
license:            GPL-3.0-only
license-file:       LICENSE
author:             Isaac Elliott
maintainer:         isaace71295@gmail.com
category:           Web
build-type:         Simple

common warnings
    ghc-options: -Wall -Wunused-packages

library
    import:           warnings
    hs-source-dirs:   src
    exposed-modules:
        Blog.Build
        Blog.Log
        Blog.Metadata
        Blog.Pandoc
        Blog.Store
        Blog.Store.Overlay
        Blog.Template
        IO
    build-depends:
        aeson,
        base ^>=4.20.2.0,
        base16-bytestring,
        blog-lib,
        bytestring,
        containers,
        cryptohash-sha256,
        diagnostica,
        diagnostica-sage,
        directory,
        exceptions,
        filepath,
        mmorph,
        mtl,
        pandoc >=3.8 && <3.11,
        pandoc-types,
        sage,
        tar,
        temple,
        text >=2.0,
        time,
        tomlin,
        transformers
    default-language: Haskell2010

executable blog-server
    import:           warnings
    main-is:          Main.hs
    other-modules:
        Blog.Route
        Blog.Rules
        Blog.Time
    build-depends:
        argon2,
        base ^>=4.20.2.0,
        blog-lib,
        blog-server,
        bytestring,
        containers,
        cookie,
        directory,
        exceptions,
        filepath,
        http-api-data >=0.7,
        http-types,
        mtl,
        optparse-applicative,
        pandoc,
        pandoc-types,
        sage,
        stm,
        temple,
        text >=2.0,
        -- `text-short` is required to use `argon2`
        text-short,
        time,
        tomlin,
        transformers,
        wai,
        warp,
        warp-tls

    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N

test-suite blog-server-tests
    import:           warnings
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:    Test.Blog.Store.Overlay
    build-depends:
        async,
        base,
        barbies,
        blog-lib,
        blog-server,
        bytestring,
        containers,
        crypton-connection,
        crypton-x509-store,
        directory,
        filepath,
        hedgehog,
        hspec,
        hspec-hedgehog,
        http-api-data,
        http-client,
        http-client-tls,
        http-types,
        mmorph,
        mtl,
        process,
        temporary,
        text,
        tls

    default-language: Haskell2010
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
