cabal-version:      3.0
name:               blog-cli
version:            0.1.0.0
license:            GPL-3.0-only
license-file:       LICENSE
author:             Isaac Elliott
maintainer:         isaace71295@gmail.com
category:           Web
build-type:         Simple

common warnings
    ghc-options: -Wall -Wunused-packages

executable blog
    import:           warnings
    hs-source-dirs:   app
    main-is:          Main.hs
    other-modules:    Paths_blog_cli
    build-depends:
        base ^>=4.20.2.0,
        blog-lib,
        bytestring,
        crypton-connection,
        crypton-x509-store,
        diagnostica,
        diagnostica-sage,
        directory,
        exceptions,
        filepath,
        http-api-data >=0.7,
        http-client,
        http-client-tls,
        http-types,
        optparse-applicative,
        process,
        sage,
        text,
        time,
        tomlin,
        tls,
        transformers,
        unix

    default-language: Haskell2010
    ghc-options:      -threaded
