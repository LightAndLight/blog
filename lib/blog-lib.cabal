cabal-version:      3.0
name:               blog-lib
version:            0.1.0.0
license:            GPL-3.0-only
license-file:       LICENSE
author:             Isaac Elliott
maintainer:         isaace71295@gmail.com
category:           Web
build-type:         Simple

common warnings
    ghc-options: -Wall -Wunused-packages

library
    import:           warnings
    exposed-modules:
        Blog
        Blog.Diagnostic
        Blog.Error
        Blog.ID
        Blog.Password
        Blog.Session
    build-depends:
        argon2,
        base ^>=4.20.2.0,
        bytestring,
        containers,
        diagnostica,
        diagnostica-sage,
        entropy,
        mtl,
        sage,
        temple,
        text >=2.0,
        text-short,
        time,
        tomlin
    hs-source-dirs:   src
    default-language: Haskell2010
